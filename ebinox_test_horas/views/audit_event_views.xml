<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_event_list" model="ir.ui.view">
        <field name="name">test.horas.audit.event.list</field>
        <field name="model">test.horas.audit.event</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="occurred_at"/>
                <field name="actor_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="action"/>
                <field name="source_model"/>
                <field name="source_display_name"/>
                <field name="summary"/>
                <field name="payload_sha256"/>
            </list>
        </field>
    </record>
    <record id="view_audit_event_form" model="ir.ui.view">
        <field name="name">test.horas.audit.event.form</field>
        <field name="model">test.horas.audit.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group><field name="occurred_at"/><field name="actor_id"/><field name="company_id"/></group>
                        <group><field name="action"/><field name="source_model"/><field name="source_record_id"/><field name="source_display_name"/></group>
                    </group>
                    <field name="summary"/>
                    <group string="Integridad"><field name="payload_sha256"/></group>
                    <field name="payload_json" widget="text"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_audit_event_search" model="ir.ui.view">
        <field name="name">test.horas.audit.event.search</field>
        <field name="model">test.horas.audit.event</field>
        <field name="arch" type="xml">
            <search string="Auditoría transversal">
                <field name="action"/><field name="source_model"/><field name="source_display_name"/><field name="actor_id"/><field name="occurred_at"/>
                <separator/>
                <filter name="group_action" string="Acción" context="{'group_by': 'action'}"/>
                <filter name="group_model" string="Modelo origen" context="{'group_by': 'source_model'}"/>
                <filter name="group_actor" string="Usuario" context="{'group_by': 'actor_id'}"/>
                <filter name="group_day" string="Día" context="{'group_by': 'occurred_at:day'}"/>
            </search>
        </field>
    </record>
    <record id="action_audit_event" model="ir.actions.act_window">
        <field name="name">Auditoría transversal</field>
        <field name="res_model">test.horas.audit.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_event_search"/>
    </record>
</odoo>
