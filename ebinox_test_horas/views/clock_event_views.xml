<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clock_event_tree" model="ir.ui.view">
        <field name="name">test.horas.clock.event.tree</field>
        <field name="model">test.horas.clock.event</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="timestamp"/>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="event_kind"/>
                <field name="source"/>
                <field name="external_id"/>
                <field name="imported_at"/>
            </list>
        </field>
    </record>
    <record id="view_clock_event_form" model="ir.ui.view">
        <field name="name">test.horas.clock.event.form</field>
        <field name="model">test.horas.clock.event</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group><field name="employee_id"/><field name="timestamp"/><field name="event_kind"/></group>
                        <group><field name="source"/><field name="external_id"/><field name="imported_at"/><field name="imported_by_id"/></group>
                    </group>
                    <group string="Auditoría de origen"><field name="source_payload" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clock_event" model="ir.actions.act_window">
        <field name="name">Marcaciones crudas</field>
        <field name="res_model">test.horas.clock.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

