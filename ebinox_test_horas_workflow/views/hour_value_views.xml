<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hour_value_list" model="ir.ui.view">
        <field name="name">test.horas.hour.value.list</field>
        <field name="model">test.horas.hour.value</field>
        <field name="arch" type="xml">
            <list><field name="employee_id"/><field name="identification_snapshot"/><field name="company_id"/><field name="hourly_value"/><field name="currency_id"/><field name="source"/><field name="source_reference"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_hour_value_form" model="ir.ui.view">
        <field name="name">test.horas.hour.value.form</field>
        <field name="model">test.horas.hour.value</field>
        <field name="arch" type="xml">
            <form delete="false"><sheet><group><group><field name="company_id"/><field name="employee_id"/><field name="identification_snapshot"/><field name="hourly_value"/><field name="currency_id"/></group><group><field name="source"/><field name="source_reference"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></group></group><field name="notes"/></sheet></form>
        </field>
    </record>
    <record id="action_hour_value" model="ir.actions.act_window">
        <field name="name">Valores hora privados</field>
        <field name="res_model">test.horas.hour.value</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_hour_value" name="Valores hora" parent="ebinox_test_horas.menu_test_horas_overtime" action="action_hour_value" sequence="15" groups="ebinox_test_horas.group_test_horas_payroll"/>

    <record id="view_overtime_valuation_form_hour_value" model="ir.ui.view">
        <field name="name">test.horas.overtime.valuation.form.hour.value</field>
        <field name="model">test.horas.overtime.valuation</field>
        <field name="inherit_id" ref="ebinox_test_horas.view_overtime_valuation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_hour_value']" position="before">
                <field name="hour_value_id"/>
                <button name="action_resolve_hour_value" type="object" string="Resolver tarifa vigente"/>
            </xpath>
            <xpath expr="//field[@name='source_hour_value']" position="after">
                <field name="manual_source_reference"/>
                <field name="hour_value_source_snapshot" invisible="not hour_value_source_snapshot"/>
            </xpath>
        </field>
    </record>
</odoo>
