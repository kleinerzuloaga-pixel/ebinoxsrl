<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!--Colocamos un report para visualizar o no en el reporte-->
        <record id="view_add_exchange_field" model="ir.ui.view">
            <field name="name">add.exchange.fied</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@name='journal_div']"  position="after">
                  <field name="es_manual_rate" attrs="{'invisible': ['|',('move_type', 'in', ('out_invoice', 'out_refund')),('currency_id', 'in', (1))]}"/>
                  <field name="currency_rate"  attrs="{'invisible': ['|',('move_type', 'in', ('out_invoice', 'out_refund')),('currency_id', 'in', (1))]}"/>
                </xpath>
                
                <!--xpath expr="//field[@name='l10n_latam_document_type_id']" position="after">

                    <field name="currency_name" invisible="1"/>
                    <field name="exchange" attrs="{'invisible':[('currency_name', '=', 'ARS')]}"/> 
                
                </xpath--> 
            
            </field>

        </record>

</odoo>
